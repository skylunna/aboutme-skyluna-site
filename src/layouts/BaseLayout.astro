---
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-white">
    <div id="top"></div>

    <main class="max-w-[1000px] mx-auto px-10 py-20">
      <slot />
      <Footer />
    </main>
  </body>
</html>
