---
import headshot from '../assets/profile/avatar.jpg';
---
<header class="mb-16">
  <div class="flex items-center gap-5 mb-4">
    <div class="w-26 h-26 rounded-full overflow-hidden border-2 border-white shadow-sm shrink-0">
      <img
        src={headshot.src}
        alt="Zheng Tianlun"
        class="w-full h-full object-cover"
      />
    </div>
    <h1 class="text-2xl font-semibold">Zheng Tianlun</h1>
  </div>
  <p class="text-gray-600 text-base leading-relaxed mb-4">
    Software engineer interested in backend architecture, DevOps, and web technologies.
    I build reliable systems and clean interfaces.
  </p>
  <div class="flex gap-4 text-sm">
    <a href="https://github.com/skylunna">GitHub</a>
    <span class="text-gray-300">/</span>
    <a href="mailto:tianlunnn@email.com">Email</a>
  </div>
</header>
